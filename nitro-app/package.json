{
	"name": "nitro-app",
	"private": true,
	"scripts": {
		"build": "nitro build",
		"dev": "nitro dev",
		"preview": "node .output/server/index.mjs",
		"migrate": "bunx --bun prisma migrate dev --name init",
		"generate": "bunx --bun prisma generate",
		"postinstall": "prisma generate",
		"db:seed": "tsx prisma/seed.ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@types/node": "^25.9.2",
		"@types/pg": "^8.20.0",
		"fast-check": "3.23.2",
		"h3": "^1.15.4",
		"nitropack": "^2.12.4",
		"prisma": "^7.8.0",
		"typescript": "~5.9",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"dotenv": "^17.4.2",
		"google-auth-library": "^11.3.4",
		"hyparquet": "^1.26.2",
		"hyparquet-compressors": "^1.1.1",
		"pg": "^8.21.0",
		"resend": "^6.31.0",
		"sharp": "0.33.5"
	}
}
