// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ActivityLog {
	id Int @id @default(autoincrement())
	type String
	message String
	occurred_at DateTime @default(now())

	user User @relation(fields: [user_id], references: [id])
	user_id Int
	product Product? @relation(fields: [product_id], references: [id])
	product_id Int?
	pantry_item PantryItem? @relation(fields: [pantry_item_id], references: [id])
	pantry_item_id Int?

	created_at DateTime @default(now())
	updated_at DateTime @updatedAt
	deleted_at DateTime?
}

model User { 
  id    Int     @id @default(autoincrement()) 
  name String 
  email String  @unique 
  password String 
  last_active DateTime
  status String
  avatar_base64 String? 

  notifications Notification[]
  dietary_prof DietaryProfile[]
  allergens Allergen[] @relation("user_allergens")
  pantry_item PantryItem[]
  scan Scan[]
  activityLog ActivityLog[]
  recipe_interactions RecipeInteraction[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?
} 

model DietaryProfile {
	id Int @id @default(autoincrement())
	user_id Int
	halal_pref Boolean @default(false)
	custom_preferences String[] @default([])

	user User @relation(fields: [user_id], references: [id])

	created_at DateTime @default(now())
  	updated_at DateTime @updatedAt
  	deleted_at DateTime?
}

model Notification {
	id Int @id @default(autoincrement())
	user User @relation(fields: [user_id], references: [id])
	user_id Int
	type String
	message String
	is_read Boolean @default(false)

	pantry_item PantryItem? @relation(fields: [pantry_item_id], references: [id])
	pantry_item_id Int?
	product Product? @relation(fields: [product_id], references: [id])
	product_id Int?

	created_at DateTime @default(now())
  	updated_at DateTime @updatedAt
  	deleted_at DateTime?
}

model Allergen {
	id Int @id @default(autoincrement())
	name String @unique
	scientific_name String
	is_predefined Boolean @default(false)

	users User[] @relation("user_allergens")
	ingredient_mapping IngredientMapping[]

	created_at DateTime @default(now())
  	updated_at DateTime @updatedAt
  	deleted_at DateTime?
}

model IngredientMapping {
	id Int @id @default(autoincrement())
	scientific_term String @unique
	simplified_term String

	allergen Allergen @relation(fields: [allergen_id], references: [id])
	allergen_id Int

	created_at DateTime @default(now())
  	updated_at DateTime @updatedAt
  	deleted_at DateTime?
}
 
model Recipe {
	id Int @id @default(autoincrement())
	name String
	instructions String
	portions_guide Json

	image_url String?

	source String @default("kaggle")
	external_id String? @unique
	raw_ingredients Json @default("[]")
	ingredient_search_text String @default("")

	ingredients Ingredient[]
	recipe_interactions RecipeInteraction[]

	created_at DateTime @default(now())
	updated_at DateTime @updatedAt
	deleted_at DateTime?
}

model RecipeInteraction {
	id Int @id @default(autoincrement())
	liked Boolean @default(false)
	made_at DateTime?

	user User @relation(fields: [user_id], references: [id])
	user_id Int
	recipe Recipe @relation(fields: [recipe_id], references: [id])
	recipe_id Int

	created_at DateTime @default(now())
  	updated_at DateTime @updatedAt
  	deleted_at DateTime?

	@@unique([user_id, recipe_id])
}

model Ingredient {
	id Int @id @default(autoincrement())
	quantity_needed Decimal
	unit String

	recipe Recipe @relation(fields: [recipe_id], references: [id])
	recipe_id Int
	product Product @relation(fields: [product_id], references: [id])
	product_id Int 

	created_at DateTime @default(now())
  	updated_at DateTime @updatedAt
  	deleted_at DateTime?
}

model Product {
	id Int @id @default(autoincrement())
	brand_name String
	product_name String
	ingredient_text String
	simplified_ingredients String
	is_verified Boolean @default(false)
	image_base64 String?
	image_base64_back String?

	halal_logo HalalLogo? @relation(fields: [halal_logo_id], references: [id])
	halal_logo_id Int?
	halal_logos ProductHalalLogo[]

	pantry_item PantryItem[]
	scan Scan[]
	ingredients Ingredient[]
	activityLog ActivityLog[]
	notification Notification[]

	confirmed_not_halal Boolean @default(false)
	// True when the AI detected a Halal-looking logo on the packaging but it
	// couldn't be resolved to any known HalalLogo row — distinct from both
	// "certified" (halal_logo_id/halal_logos set) and "confirmed not halal".
	// Needed so the Pantry Overview can actually render a "Not verified"
	// state — without this, Product had no way to record that fact at all.
	halal_unverified Boolean @default(false)
	created_at DateTime @default(now())
  	updated_at DateTime @updatedAt
  	deleted_at DateTime?
}

model HalalLogo {	
  id              Int      @id @default(autoincrement())
  certifier       String   @unique
  full_name       String
  image_path      String
  source_url      String
  scraped_date    DateTime

  is_accredited   Boolean  @default(false)

  product         Product[]
  catalog_product CatalogProduct[]
  product_links         ProductHalalLogo[]
  catalog_product_links CatalogProductHalalLogo[]
}


model PantryItem {
	id Int @id @default(autoincrement())
	expiration_date DateTime?
	best_before_date DateTime?
	storage_location String
	quantity Decimal
	portion_unit String
	added_date DateTime
	is_archived Boolean @default(false)

	user User @relation(fields: [user_id], references: [id])
	user_id Int

	product Product @relation(fields: [product_id], references: [id])
	product_id Int

	activityLog ActivityLog[]
	notification Notification[]

	created_at DateTime @default(now())
  	updated_at DateTime @updatedAt
  	deleted_at DateTime?
}

model Scan {
	id Int @id @default(autoincrement())
	image_url String

	image_url_back String?
	scan_time DateTime
	ai_confidence_score Decimal
	safety_verdict String
	flag_reason String

	user User @relation(fields: [user_id], references: [id])
	user_id Int
	product Product @relation(fields: [product_id], references: [id])
	product_id Int
	flagged_scan FlaggedScan[]

	created_at DateTime @default(now())
  	updated_at DateTime @updatedAt
  	deleted_at DateTime?
}

model FlaggedScan {
	id Int @id @default(autoincrement())
	flag_reason String
	status String @default("pending")
	admin_correction String?

	scan Scan @relation(fields: [scan_id], references: [id])
	scan_id Int
	admin Admin? @relation(fields: [admin_id], references: [id])
	admin_id Int?

	created_at DateTime @default(now())
  	updated_at DateTime @updatedAt
  	deleted_at DateTime?
}

// --- Alternatives feature: reference catalog (separate from Product) ---
//
// Deliberately NOT reusing `Product`: Product rows represent things a real
// user actually scanned or put in their pantry (Scan.product_id and
// PantryItem.product_id both point there). Mixing in ~108 reference-only
// catalog rows with no discriminator field would mean any query for "the
// user's scanned/pantry products" could accidentally surface catalog
// entries nobody ever scanned. This mirrors the existing 108-row seed
// (brand_name/product_name/ingredient_text/simplified_ingredients/
// is_verified/match_key), now moved to its own table plus a structured
// ingredient relationship for genuine AI-driven Alternative matching
// (allowed/disallowed ingredient reasoning), rather than plain-text
// filtering.

model CatalogProduct {
	id Int @id @default(autoincrement())
	brand_name String
	product_name String
	ingredient_text String
	simplified_ingredients String
	is_verified Boolean @default(false)
	match_key String @unique

	halal_logo HalalLogo? @relation(fields: [halal_logo_id], references: [id])
	halal_logo_id Int?
	halal_logos CatalogProductHalalLogo[]
	ingredients CatalogProductIngredient[]

	confirmed_not_halal Boolean @default(false)
	halal_unverified Boolean @default(false)
	created_at DateTime @default(now())
  	updated_at DateTime @updatedAt
  	deleted_at DateTime?
}

model CatalogIngredient {
	id Int @id @default(autoincrement())
	name String @unique

	products CatalogProductIngredient[]

	created_at DateTime @default(now())
  	updated_at DateTime @updatedAt
  	deleted_at DateTime?
}

model CatalogProductIngredient {
	id Int @id @default(autoincrement())

	catalog_product CatalogProduct @relation(fields: [catalog_product_id], references: [id])
	catalog_product_id Int
	catalog_ingredient CatalogIngredient @relation(fields: [catalog_ingredient_id], references: [id])
	catalog_ingredient_id Int

	created_at DateTime @default(now())
  	updated_at DateTime @updatedAt
  	deleted_at DateTime?

	@@unique([catalog_product_id, catalog_ingredient_id])
}

// A product can genuinely hold more than one real-world Halal certification
// (e.g. a product certified by both IDCP and JAKIM) — Product/CatalogProduct
// keep their original single `halal_logo_id` FK for backward compatibility
// (existing admin approval flow, existing scanned/seeded rows), but this
// join table is the actual source of truth going forward for "which
// certifications does this product have," same shape as
// CatalogProductIngredient above.
model ProductHalalLogo {
	id Int @id @default(autoincrement())

	product Product @relation(fields: [product_id], references: [id])
	product_id Int
	halal_logo HalalLogo @relation(fields: [halal_logo_id], references: [id])
	halal_logo_id Int

	created_at DateTime @default(now())
  	updated_at DateTime @updatedAt
  	deleted_at DateTime?

	@@unique([product_id, halal_logo_id])
}

model CatalogProductHalalLogo {
	id Int @id @default(autoincrement())

	catalog_product CatalogProduct @relation(fields: [catalog_product_id], references: [id])
	catalog_product_id Int
	halal_logo HalalLogo @relation(fields: [halal_logo_id], references: [id])
	halal_logo_id Int

	created_at DateTime @default(now())
  	updated_at DateTime @updatedAt
  	deleted_at DateTime?

	@@unique([catalog_product_id, halal_logo_id])
}

model Admin {
	id Int @id @default(autoincrement())
	full_name String
	username String @unique
	password String
	role String
	flagged_scan FlaggedScan[] 
}
